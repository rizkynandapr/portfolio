# Copy to .env.local for `npm run dev`; set the same keys in Vercel → Settings → Environment Variables.
# Never prefix these with VITE_ — that would ship them to the browser.

# Required for the "Ask my agent" console.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-4-5.
ANTHROPIC_MODEL=

# Optional but recommended in production: shared rate-limit counters across
# serverless instances (Upstash Redis REST). Without them limits are per-instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Extra origins allowed to call /api/chat (comma-separated), e.g. a custom domain.
ALLOWED_ORIGINS=

# Optional. Hard cap on total agent requests per day across all visitors. Default 800.
CHAT_GLOBAL_DAILY_CAP=
